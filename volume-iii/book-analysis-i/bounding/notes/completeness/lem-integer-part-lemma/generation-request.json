      "source_line_start": 358,
      "source_line_end": 374,
      "current_tex": "\\begin{lemma}[Integer Part Lemma]\n\\label{lem:integer-part-lemma}\nFor every $x\\in\\mathbb{R}$ satisfying $x\\geq0$, there exists a unique\n$n\\in\\mathbb{N}_0$ such that\n\\[\n  n\\leq x<n+1.\n\\]\nEquivalently,\n\\[\n  (\\forall x\\in\\mathbb{R})\n  \\left[x\\geq0\\Longrightarrow(\\exists!n\\in\\mathbb{N}_0)(n\\leq x<n+1)\\right].\n\\]\n\n\\smallskip\n\\noindent\n\\hyperref[prf:integer-part-lemma]{\\textit{Go to proof.}}\n\\end{lemma}",
      "formalizations": []
    }
  },
