      "source_line_start": 330,
      "source_line_end": 337,
      "current_tex": "\\begin{definition}[Bounded Below]\n\\label{def:bounded-below}\nLet $A\\subseteq\\mathbb{R}$. The set $A$ is \\emph{bounded below} if there\nexists a lower bound of $A$ in $\\mathbb{R}$; equivalently,\n\\[\n  (\\exists \\ell\\in\\mathbb{R})(\\forall a\\in A)(\\ell\\leq a).\n\\]\n\\end{definition}",
      "formalizations": []
    }
