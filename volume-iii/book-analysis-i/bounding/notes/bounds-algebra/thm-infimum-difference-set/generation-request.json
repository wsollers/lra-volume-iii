      "source_line_start": 1456,
      "source_line_end": 1465,
      "current_tex": "\\begin{theorem}[Infimum of a Difference Set]\n\\label{thm:infimum-difference-set}\nLet $A,B\\subseteq\\mathbb{R}$ be nonempty, with $A$ bounded below and $B$\nbounded above.  Then $A-B:=\\{a-b:a\\in A,\\ b\\in B\\}$ is nonempty and bounded\nbelow, and\n\\[\n  \\inf(A-B)=\\inf A-\\sup B.\n\\]\n\\hyperref[prf:infimum-difference-set]{Go to proof.}\n\\end{theorem}",
      "formalizations": []
    }
  },
  "creation_mode": "prompt"
