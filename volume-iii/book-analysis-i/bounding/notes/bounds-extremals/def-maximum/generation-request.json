      "environment_kind": "definition",
      "source_line_start": 17,
      "source_line_end": 26,
      "current_tex": "\\begin{definition}[Maximum]\n\\label{def:maximum}\nLet $A\\subseteq\\mathbb{R}$ and let $m\\in\\mathbb{R}$. The number $m$ is the\n\\emph{maximum} of $A$, written $m=\\max A$, if\n\\[\n  m\\in A\n  \\land\n  (\\forall a\\in A)(a\\leq m).\n\\]\n\\end{definition}",
      "formalizations": []
    }
