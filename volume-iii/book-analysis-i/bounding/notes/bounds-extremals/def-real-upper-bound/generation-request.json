      "source_line_start": 105,
      "source_line_end": 112,
      "current_tex": "\\begin{definition}[Upper Bound in the Real Line]\n\\label{def:real-upper-bound}\nLet $A\\subseteq\\mathbb{R}$ and let $u\\in\\mathbb{R}$. The number $u$ is an\n\\emph{upper bound} of $A$ if\n\\[\n  (\\forall a\\in A)(a\\leq u).\n\\]\n\\end{definition}",
      "formalizations": []
    }
