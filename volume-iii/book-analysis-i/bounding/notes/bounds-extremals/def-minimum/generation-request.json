      "source_line_start": 106,
      "source_line_end": 115,
      "current_tex": "\\begin{definition}[Minimum]\n\\label{def:minimum}\nLet $A\\subseteq\\mathbb{R}$ and let $n\\in\\mathbb{R}$. The number $n$ is the\n\\emph{minimum} of $A$, written $n=\\min A$, if\n\\[\n  n\\in A\n  \\land\n  (\\forall a\\in A)(n\\leq a).\n\\]\n\\end{definition}",
      "formalizations": []
    }
